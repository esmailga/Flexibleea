rules_version = '2';

// Flexibleea Cloud Storage security rules.
//
//   userImages/{uid}.jpg                 - profile photos
//   qualifications/{uid}/{listingId}.pdf - optional qualification documents
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /userImages/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && fileName == request.auth.uid + '.jpg'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if signedIn()
        && (fileName == request.auth.uid + '.jpg' || isAdmin());
    }

    match /qualifications/{uid}/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }
  }
}
